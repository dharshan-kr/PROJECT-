def fetch_sensor_data() -> pd.DataFrame:
    try:
        df = pd.read_csv(READ_CH1_FULL)
        if df.empty: return pd.DataFrame()
        rename_dict = {'created_at': 'timestamp', 'field1': 'temp', 'field2': 'pulse', 'field3': 'resp', 'field4': 'vib'}
        df = df.rename(columns=rename_dict)
        df.dropna(subset=['temp', 'pulse', 'resp', 'vib'], inplace=True)
        df['timestamp'] = pd.to_datetime(df['timestamp']).dt.tz_localize(None)
        return df
    except:
        return pd.DataFrame()

def fetch_now():
    try:
        df = pd.read_csv(READ_CH1_LATEST)
        if df.empty: return {"temp": 0, "pulse": 0, "resp": 0, "vib": 0}
        return {
            "temp": df['field1'].iloc[-1],
            "pulse": df['field2'].iloc[-1],
            "resp": df['field3'].iloc[-1],
            "vib": df['field4'].iloc[-1]
        }
    except:
        return {"temp": 0, "pulse": 0, "resp": 0, "vib": 0}

