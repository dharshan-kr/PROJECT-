def get_leon_response(prompt, vitals):
    if not llm: return "LEON Offline. Please check Ollama connection."
    context = f"Current Vitals: Temp {vitals.get('temp')}C, Pulse {vitals.get('pulse')}BPM, Resp {vitals.get('resp')}RPM."
    return llm.invoke(f"System: You are LEON, a wildlife expert. {context} User: {prompt}")

def get_global_leon_report(prompt, fleet_data):
    if not llm: return "Global Scan Unavailable."
    return llm.invoke(f"Analyze this fleet data and report abnormalities: {fleet_data}")

